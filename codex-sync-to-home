#!/bin/bash

set -euo pipefail

CODEX_REPO="$(cd "$(dirname "$0")" && pwd)"
CODEX_SRC="$CODEX_REPO/home"
CODEX_HOME="$HOME/.codex"
BACKUP_DIR="$CODEX_REPO/_backup"
MAX_BACKUPS=5

# Subdirectories we fully manage. Orphan files inside these are listed and
# offered for deletion with confirmation. skills/.system/ is Codex-owned
# and excluded from sync and orphan checks.
MANAGED_DIRS=("rules/dev-tools" "skills")

mkdir -p "$CODEX_HOME" "$BACKUP_DIR"

list_orphans() {
    local d="$1"
    local home_d="$CODEX_HOME/$d"
    local src_d="$CODEX_SRC/$d"
    # return 0 (not bare return) so the [ -d ] failure status doesn't propagate
    # through the `n=$(... | wc -l)` pipefail and abort the script under set -e.
    [ -d "$home_d" ] || return 0
    while IFS= read -r -d '' f; do
        local rel="${f#$home_d/}"
        [ -f "$src_d/$rel" ] || echo "$f"
    done < <(find "$home_d" -type d -name '.system' -prune -o -type f -print0 2>/dev/null)
}

# Detect changes (rsync dry-run) and orphans before doing anything
sync_changes=$(rsync -an --itemize-changes --exclude='skills/.system/' \
    "$CODEX_SRC/" "$CODEX_HOME/" 2>/dev/null | grep -cE '^[<>ch]' || true)
orphan_count=0
for d in "${MANAGED_DIRS[@]}"; do
    n=$(list_orphans "$d" | wc -l)
    orphan_count=$((orphan_count + n))
done

# config.toml is local-only: it never lives in home/ and is never overwritten.
# We only *seed* it from the repo template (local/config.toml.example) on a
# machine that doesn't have one yet (e.g. a fresh clone). An existing
# config.toml is left untouched.
CONFIG_EXAMPLE="$CODEX_REPO/local/config.toml.example"
need_seed=0
if [ ! -f "$CODEX_HOME/config.toml" ] && [ -f "$CONFIG_EXAMPLE" ]; then
    need_seed=1
fi

if [ "$sync_changes" -eq 0 ] && [ "$orphan_count" -eq 0 ] && [ "$need_seed" -eq 0 ]; then
    echo "No changes."
    exit 0
fi

# Backup managed state before overwrite
timestamp=$(date +"%Y-%m-%d_%H-%M-%S")
backup_target="$BACKUP_DIR/$timestamp"
mkdir -p "$backup_target"
echo "Backing up ~/.codex → _backup/$timestamp"
for d in "${MANAGED_DIRS[@]}"; do
    src="$CODEX_HOME/$d"
    [ -d "$src" ] || continue
    dst="$backup_target/$d"
    mkdir -p "$(dirname "$dst")"
    cp -a "$src" "$dst"
done
for f in "$CODEX_SRC"/*; do
    [ -f "$f" ] || continue
    bn=$(basename "$f")
    [ -f "$CODEX_HOME/$bn" ] && cp -a "$CODEX_HOME/$bn" "$backup_target/"
done

# Prune old backups
find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d | sort -r \
    | tail -n +$((MAX_BACKUPS + 1)) | xargs -r rm -rf

# Sync home/ -> ~/.codex/ (add/update only; skills/.system/ preserved)
echo ""
echo "Syncing home/ → ~/.codex ..."
rsync -a --exclude='skills/.system/' "$CODEX_SRC/" "$CODEX_HOME/"

# Seed config.toml on first run only; never overwrite an existing one.
if [ "$need_seed" -eq 1 ]; then
    echo ""
    echo "✓ config.toml seeded (local/config.toml.example → ~/.codex/config.toml, first run only)"
    cp "$CONFIG_EXAMPLE" "$CODEX_HOME/config.toml"
elif [ -f "$CODEX_HOME/config.toml" ]; then
    echo ""
    echo "ⓘ ~/.codex/config.toml exists — left untouched."
fi

# Orphan handling within managed subdirs (confirmed delete).
# `|| ans=""` keeps EOF on stdin (non-interactive runs) from aborting under set -e.
for d in "${MANAGED_DIRS[@]}"; do
    mapfile -t orphans < <(list_orphans "$d")
    [ ${#orphans[@]} -gt 0 ] || continue
    echo ""
    echo "Orphan files in ~/.codex/$d/ (present in dest but not in repo home/$d/):"
    for o in "${orphans[@]}"; do echo "  ${o#$CODEX_HOME/}"; done
    read -r -p "Delete these ${#orphans[@]} file(s)? [y/N]: " ans || ans=""
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        for o in "${orphans[@]}"; do rm -v "$o"; done
        find "$CODEX_HOME/$d" -type d -empty -delete 2>/dev/null || true
    else
        echo "Skipped."
    fi
done

echo ""
echo "Done!"
