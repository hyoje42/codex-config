#!/bin/bash

set -euo pipefail

CODEX_REPO="$(cd "$(dirname "$0")" && pwd)"
CODEX_SRC="$CODEX_REPO/home"
CODEX_HOME="$HOME/.codex"
CODEX_SKILLS_SRC="$CODEX_SRC/skills"
AGENTS_SKILLS_HOME="$HOME/.agents/skills"
LEGACY_SKILLS_HOME="$CODEX_HOME/skills"
MERGE_HELPER="$CODEX_REPO/codex-merge-config"
CONFIG_BASE="$CODEX_SRC/config.toml"
CONFIG_OVERRIDE="$CODEX_REPO/local/config.override.toml"
CONFIG_TARGET="$CODEX_HOME/config.toml"

if [ ! -x "$MERGE_HELPER" ]; then
    echo "codex-diff-with-home: config merge helper를 실행할 수 없습니다: $MERGE_HELPER" >&2
    exit 1
fi

print_config_note_and_diff() {
    local merged_tmp
    merged_tmp="$(mktemp)"
    "$MERGE_HELPER" "$CONFIG_BASE" "$CONFIG_OVERRIDE" "$CONFIG_TARGET" > "$merged_tmp"

    if [ -f "$CONFIG_OVERRIDE" ]; then
        echo "ⓘ config.toml: 현재 파일 + home/config.toml + local/config.override.toml merge 결과를 비교합니다."
    else
        echo "ⓘ config.toml: 현재 파일 + home/config.toml merge 결과를 비교합니다 (local override 없음)."
    fi

    if [ ! -f "$CONFIG_TARGET" ]; then
        new_files+=("config.toml")
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  config.toml"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        sed 's/^/+/' "$merged_tmp"
        echo ""
    elif ! cmp -s "$merged_tmp" "$CONFIG_TARGET"; then
        changed_files+=("config.toml")
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  config.toml"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        { diff -u "$CONFIG_TARGET" "$merged_tmp" --label "~/.codex/config.toml" --label "merge 결과 config.toml" 2>/dev/null || true; } | tail -n +3
        echo ""
    fi
    rm -f "$merged_tmp"
}

# .bashrc codex 래퍼도 머신 종속이라 파일별 diff에는 없다. sync가 ~/.bashrc에
# 무엇을 할지(설치/보존/아무것도 안 함)를 미리 안내해 이 미리보기가 실제 동작을
# 반영하게 한다. 판정 기준은 codex-sync-to-home의 need_wrapper 로직과 동일하다.
print_wrapper_note() {
    local real="$CODEX_REPO/local/codex-proxy-wrapper.sh"
    local marker="# >>> codex proxy wrapper >>>"
    if grep -qF "$marker" "$HOME/.bashrc" 2>/dev/null; then
        echo "ⓘ codex 래퍼: ~/.bashrc에 이미 있음 → sync가 건드리지 않습니다."
    elif [ ! -f "$real" ]; then
        echo "ⓘ codex 래퍼: local/codex-proxy-wrapper.sh 없음 → sync가 아무것도 하지 않습니다 (.example만으론 설치 안 함)."
    elif grep -qF '<PROXY_HOST>' "$real"; then
        echo "⚠ codex 래퍼: local/codex-proxy-wrapper.sh에 placeholder 남음 → 실제 값으로 채우면 sync가 ~/.bashrc에 설치합니다."
    else
        echo "ⓘ codex 래퍼: ~/.bashrc에 없음 → sync 시 local/codex-proxy-wrapper.sh에서 ~/.bashrc에 설치됩니다."
    fi
}

changed_files=()
new_files=()
deleted_files=()
legacy_skill_dirs=()

compare_file() {
    local rel_path="$1"
    local repo_file="$CODEX_SRC/$rel_path"
    local home_file display_path home_label repo_label

    if [[ "$rel_path" == skills/* ]]; then
        home_file="$AGENTS_SKILLS_HOME/${rel_path#skills/}"
        display_path="~/.agents/skills/${rel_path#skills/}"
        home_label="$display_path"
        repo_label="repo/home/$rel_path"
    else
        home_file="$CODEX_HOME/$rel_path"
        display_path="~/.codex/$rel_path"
        home_label="$display_path"
        repo_label="repo/home/$rel_path"
    fi

    if [ ! -f "$home_file" ]; then
        new_files+=("$display_path")
        return
    fi

    if ! diff -q "$repo_file" "$home_file" > /dev/null 2>&1; then
        changed_files+=("$display_path")
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  $display_path"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        # `|| true`로 diff의 exit 1(차이 있음)이 set -e/pipefail에서 스크립트를 중단시키지 않게 한다
        { diff -u "$home_file" "$repo_file" --label "$home_label" --label "$repo_label" 2>/dev/null || true; } | tail -n +3
        echo ""
    fi
}

echo ""
echo "repo/home → ~/.codex + ~/.agents/skills 비교 중"
echo ""
print_wrapper_note
echo ""
print_config_note_and_diff

# home/의 모든 파일을 순회한다 (최상위 + 관리 대상 하위 디렉터리 모두 여기서 처리)
while IFS= read -r -d '' repo_file; do
    rel_path="${repo_file#$CODEX_SRC/}"
    [ "$rel_path" = "config.toml" ] && continue
    compare_file "$rel_path"
done < <(find "$CODEX_SRC" -type f -print0 2>/dev/null)

# ~/.agents/skills는 여러 도구가 공유할 수 있으므로, 이 repo에 같은 이름으로
# 존재하는 skill 디렉터리 내부만 고아 파일을 검사한다.
for src_skill in "$CODEX_SKILLS_SRC"/*; do
    [ -d "$src_skill" ] || continue
    skill_name="$(basename "$src_skill")"
    target_skill="$AGENTS_SKILLS_HOME/$skill_name"
    [ -d "$target_skill" ] || continue
    while IFS= read -r -d '' home_file; do
        rel_in_skill="${home_file#$target_skill/}"
        if [ ! -f "$src_skill/$rel_in_skill" ]; then
            deleted_files+=("~/.agents/skills/$skill_name/$rel_in_skill")
        fi
    done < <(find "$target_skill" -type f -print0 2>/dev/null)
done

# 공식 loader가 deprecated로 분류한 이전 경로에 같은 이름의 skill이 남아
# 있으면 중복 로딩 위험을 별도 표시한다. .system과 다른 사용자 skill은 건드리지 않는다.
for src_skill in "$CODEX_SKILLS_SRC"/*; do
    [ -d "$src_skill" ] || continue
    skill_name="$(basename "$src_skill")"
    if [ -d "$LEGACY_SKILLS_HOME/$skill_name" ]; then
        legacy_skill_dirs+=("~/.codex/skills/$skill_name/")
    fi
done

echo "==========================================="
echo "  요약"
echo "==========================================="

if [ ${#changed_files[@]} -eq 0 ] && [ ${#new_files[@]} -eq 0 ] &&
   [ ${#deleted_files[@]} -eq 0 ] && [ ${#legacy_skill_dirs[@]} -eq 0 ]; then
    echo "  ✓ 차이 없음 — ~/.codex와 ~/.agents/skills가 이미 최신입니다."
else
    if [ ${#changed_files[@]} -gt 0 ]; then
        echo ""
        echo "  변경됨 (${#changed_files[@]}):"
        for f in "${changed_files[@]}"; do
            echo "    M  $f"
        done
    fi
    if [ ${#new_files[@]} -gt 0 ]; then
        echo ""
        echo "  repo에 새로 추가 (${#new_files[@]}):"
        for f in "${new_files[@]}"; do
            echo "    +  $f"
        done
    fi
    if [ ${#deleted_files[@]} -gt 0 ]; then
        echo ""
        echo "  관리 중인 ~/.agents skill에만 있음 (${#deleted_files[@]}):"
        for f in "${deleted_files[@]}"; do
            echo "    -  $f"
        done
    fi
    if [ ${#legacy_skill_dirs[@]} -gt 0 ]; then
        echo ""
        echo "  이전 ~/.codex/skills 경로에 남은 관리 skill (${#legacy_skill_dirs[@]}):"
        for f in "${legacy_skill_dirs[@]}"; do
            echo "    !  $f"
        done
        echo "    ↳ sync 시 백업 후 삭제 여부를 묻습니다."
    fi
fi

# 긴 diff 뒤에도 config.toml 처리 방식이 보이도록 짧게 다시 안내한다.
echo ""
echo "  ↳ config.toml은 ~/.codex merge 결과, skill은 ~/.agents/skills 기준입니다."
echo "     codex 래퍼는 머신 종속이라 파일 diff에 없습니다."
echo ""
