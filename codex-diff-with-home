#!/bin/bash

set -euo pipefail

CODEX_REPO="$(cd "$(dirname "$0")" && pwd)"
CODEX_SRC="$CODEX_REPO/home"
CODEX_HOME="$HOME/.codex"

# Subdirectories we fully manage. Orphans are reported only for these.
# skills/.system/ is Codex-owned and excluded.
MANAGED_DIRS=("rules/dev-tools" "skills")

# config.toml is machine-local: it lives only in ~/.codex/ (never in home/), so
# it is not part of the file-by-file diff below. Instead we announce what a sync
# would DO to it — seed it on a fresh machine, or leave an existing one
# untouched — so this preview reflects sync's actual behaviour.
print_config_note() {
    local example="$CODEX_REPO/local/config.toml.example"
    if [ -f "$CODEX_HOME/config.toml" ]; then
        echo "ⓘ config.toml: 이미 존재 → sync가 건드리지 않습니다 (직접 편집 대상)."
    elif [ -f "$example" ]; then
        echo "ⓘ config.toml: 없음 → sync 시 local/config.toml.example에서 seed됩니다 (최초 1회)."
    else
        echo "⚠ config.toml 없음 + local/config.toml.example 없음 → seed되지 않습니다."
    fi
}

changed_files=()
new_files=()
deleted_files=()

compare_file() {
    local rel_path="$1"
    local repo_file="$CODEX_SRC/$rel_path"
    local home_file="$CODEX_HOME/$rel_path"

    if [ ! -f "$home_file" ]; then
        new_files+=("$rel_path")
        return
    fi

    if ! diff -q "$repo_file" "$home_file" > /dev/null 2>&1; then
        changed_files+=("$rel_path")
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  $rel_path"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        # `|| true` keeps diff's exit 1 (differences found) from aborting under set -e/pipefail
        { diff -u "$home_file" "$repo_file" --label "~/.codex/$rel_path" --label "repo/home/$rel_path" 2>/dev/null || true; } | tail -n +3
        echo ""
    fi
}

echo ""
echo "Comparing repo/home → ~/.codex"
echo ""
print_config_note
echo ""

# Iterate every file in home/ (top-level + managed subdirs covered here)
while IFS= read -r -d '' repo_file; do
    rel_path="${repo_file#$CODEX_SRC/}"
    compare_file "$rel_path"
done < <(find "$CODEX_SRC" -type f -print0 2>/dev/null)

# Orphans: files in managed subdirs in ~/.codex/ that are absent in home/
# Excludes skills/.system/ (Codex-owned).
for d in "${MANAGED_DIRS[@]}"; do
    home_d="$CODEX_HOME/$d"
    src_d="$CODEX_SRC/$d"
    [ -d "$home_d" ] || continue
    while IFS= read -r -d '' home_file; do
        rel_in_dir="${home_file#$home_d/}"
        rel_path="$d/$rel_in_dir"
        if [ ! -f "$src_d/$rel_in_dir" ]; then
            deleted_files+=("$rel_path")
        fi
    done < <(find "$home_d" -type d -name '.system' -prune -o -type f -print0 2>/dev/null)
done

echo "==========================================="
echo "  Summary"
echo "==========================================="

if [ ${#changed_files[@]} -eq 0 ] && [ ${#new_files[@]} -eq 0 ] && [ ${#deleted_files[@]} -eq 0 ]; then
    echo "  ✓ 차이 없음 — ~/.codex가 이미 최신입니다."
else
    if [ ${#changed_files[@]} -gt 0 ]; then
        echo ""
        echo "  Modified (${#changed_files[@]}):"
        for f in "${changed_files[@]}"; do
            echo "    M  $f"
        done
    fi
    if [ ${#new_files[@]} -gt 0 ]; then
        echo ""
        echo "  New in repo (${#new_files[@]}):"
        for f in "${new_files[@]}"; do
            echo "    +  $f"
        done
    fi
    if [ ${#deleted_files[@]} -gt 0 ]; then
        echo ""
        echo "  Only in ~/.codex (${#deleted_files[@]}):"
        for f in "${deleted_files[@]}"; do
            echo "    -  $f"
        done
    fi
fi

# Short recap so config.toml's handling stays visible after a long diff.
echo ""
echo "  ↳ config.toml은 위 diff에 없습니다 (sync는 seed 또는 보존만 함 — 위 ⓘ 참고)."
echo ""
