#!/bin/bash

set -euo pipefail

CODEX_REPO="$(cd "$(dirname "$0")" && pwd)"
CODEX_SRC="$CODEX_REPO/home"
CODEX_HOME="$HOME/.codex"

# 우리가 완전히 관리하는 하위 디렉터리. 고아 파일은 이들에 대해서만 보고한다.
# skills/.system/는 Codex 소유라 제외한다.
MANAGED_DIRS=("skills")

# config.toml은 머신 종속이다: ~/.codex/에만 있고(home/에는 없음), 그래서
# 아래 파일별 diff에는 포함되지 않는다. 대신 sync가 config.toml에 무엇을
# 할지 — 새 머신이면 seed, 기존 파일이면 그대로 보존 — 알려줘서
# 이 미리보기가 sync의 실제 동작을 반영하도록 한다.
print_config_note() {
    local example="$CODEX_REPO/local/config.toml.example"
    if [ -f "$CODEX_HOME/config.toml" ]; then
        echo "ⓘ config.toml: 이미 존재 → sync가 건드리지 않습니다 (직접 편집 대상)."
    elif [ -f "$example" ]; then
        echo "ⓘ config.toml: 없음 → sync 시 local/config.toml.example에서 seed됩니다 (최초 1회)."
    else
        echo "⚠ config.toml 없음 + local/config.toml.example 없음 → seed되지 않습니다."
    fi
}

changed_files=()
new_files=()
deleted_files=()

compare_file() {
    local rel_path="$1"
    local repo_file="$CODEX_SRC/$rel_path"
    local home_file="$CODEX_HOME/$rel_path"

    if [ ! -f "$home_file" ]; then
        new_files+=("$rel_path")
        return
    fi

    if ! diff -q "$repo_file" "$home_file" > /dev/null 2>&1; then
        changed_files+=("$rel_path")
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  $rel_path"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        # `|| true`로 diff의 exit 1(차이 있음)이 set -e/pipefail에서 스크립트를 중단시키지 않게 한다
        { diff -u "$home_file" "$repo_file" --label "~/.codex/$rel_path" --label "repo/home/$rel_path" 2>/dev/null || true; } | tail -n +3
        echo ""
    fi
}

echo ""
echo "repo/home → ~/.codex 비교 중"
echo ""
print_config_note
echo ""

# home/의 모든 파일을 순회한다 (최상위 + 관리 대상 하위 디렉터리 모두 여기서 처리)
while IFS= read -r -d '' repo_file; do
    rel_path="${repo_file#$CODEX_SRC/}"
    compare_file "$rel_path"
done < <(find "$CODEX_SRC" -type f -print0 2>/dev/null)

# 고아 파일: ~/.codex/의 관리 대상 하위 디렉터리에 있지만 home/에는 없는 파일
# skills/.system/(Codex 소유)는 제외한다.
for d in "${MANAGED_DIRS[@]}"; do
    home_d="$CODEX_HOME/$d"
    src_d="$CODEX_SRC/$d"
    [ -d "$home_d" ] || continue
    while IFS= read -r -d '' home_file; do
        rel_in_dir="${home_file#$home_d/}"
        rel_path="$d/$rel_in_dir"
        if [ ! -f "$src_d/$rel_in_dir" ]; then
            deleted_files+=("$rel_path")
        fi
    done < <(find "$home_d" -type d -name '.system' -prune -o -type f -print0 2>/dev/null)
done

echo "==========================================="
echo "  요약"
echo "==========================================="

if [ ${#changed_files[@]} -eq 0 ] && [ ${#new_files[@]} -eq 0 ] && [ ${#deleted_files[@]} -eq 0 ]; then
    echo "  ✓ 차이 없음 — ~/.codex가 이미 최신입니다."
else
    if [ ${#changed_files[@]} -gt 0 ]; then
        echo ""
        echo "  변경됨 (${#changed_files[@]}):"
        for f in "${changed_files[@]}"; do
            echo "    M  $f"
        done
    fi
    if [ ${#new_files[@]} -gt 0 ]; then
        echo ""
        echo "  repo에 새로 추가 (${#new_files[@]}):"
        for f in "${new_files[@]}"; do
            echo "    +  $f"
        done
    fi
    if [ ${#deleted_files[@]} -gt 0 ]; then
        echo ""
        echo "  ~/.codex에만 있음 (${#deleted_files[@]}):"
        for f in "${deleted_files[@]}"; do
            echo "    -  $f"
        done
    fi
fi

# 긴 diff 뒤에도 config.toml 처리 방식이 보이도록 짧게 다시 안내한다.
echo ""
echo "  ↳ config.toml은 위 diff에 없습니다 (sync는 seed 또는 보존만 함 — 위 ⓘ 참고)."
echo ""
